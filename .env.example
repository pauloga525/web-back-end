# Copia este archivo a ".env" y completa los valores reales.
# Nunca commitees el ".env" real — ver .gitignore.

PORT=8000
NODE_ENV=development
# URL pública donde corre este backend (se usa para construir URLs de imágenes GridFS).
BACKEND_URL=http://localhost:8000

MONGODB_URI=mongodb://localhost:27017/uets_db

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS en producción (separados por coma). En desarrollo
# (NODE_ENV=development) se acepta cualquier puerto de localhost/127.0.0.1 automáticamente.
CORS_ORIGINS=https://uets.edu.ec,https://admin.uets.edu.ec

# Usuario administrador que se crea automáticamente si no existe ninguno con este username.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@uets.edu.ec

BODY_PARSER_LIMIT=50mb
